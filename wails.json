{
    "$schema": "https://wails.io/schemas/config.v3.json",
    "name": "BetterDiscord Installer",
    "outputfilename": "BetterDiscord-Installer",
    "frontend": {
        "dir": "frontend",
        "install": "bun install",
        "build": "bun run build",
        "watcher": "bun run dev",
        "devServerUrl": "http://localhost:5173"
    },
    "wailsjsdir": "./frontend/src/lib",
    "bindings": {
      "ts_generation": {
        "outputType": "interfaces"
      }
    },
    "info": {
      "productName": "BetterDiscord Installer",
      "productVersion": "2.0.0-alpha"
    },
    "author": {
      "name": "Zerebos",
      "email": "me@zerebos.com"
    }
  }
